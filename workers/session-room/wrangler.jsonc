{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "quizky-session-room",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": ["nodejs_als"],
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "quizky-db",
			"database_id": "f6a29477-b5e6-49bd-946f-198d119f3a8e",
			"migrations_dir": "../../migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION_ROOM",
				"class_name": "SessionRoom"
			},
			{
				"name": "PASSWORD_HASHER",
				"class_name": "PasswordHasher"
			}
		]
	},
	"exports": {
		"SessionRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		},
		"PasswordHasher": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
